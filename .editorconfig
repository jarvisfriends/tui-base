# EditorConfig — cross-editor formatting consistency for tui-base
# https://editorconfig.org

root = true

# Default: UTF-8, LF, trailing newline
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go — tabs (gofmt/gofumpt standard)
[*.go]
indent_style = tab
indent_size = 4

# JSON / JSONC — 2 spaces
[*.{json,jsonc}]
indent_style = space
indent_size = 2

# YAML — 2 spaces
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# TOML — 2 spaces
[*.toml]
indent_style = space
indent_size = 2

# Markdown — 2 spaces; trailing whitespace is significant (line breaks)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts — 2 spaces
[*.sh]
indent_style = space
indent_size = 2

# Makefiles — tabs (required by make)
[Makefile]
indent_style = tab

# Git config files
[.git*]
indent_style = space
indent_size = 2
